# OpenHub Environment Variables
# Copy this file to .env and fill in the values

# ===================== SERVER =====================
PORT=3000
NODE_ENV=development

# ===================== AUTH =====================
# Minimum 32 characters for each
ACCESS_TOKEN_SECRET=your-access-token-secret-min-32-chars
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-32-chars

# ===================== AI PIPELINE =====================
# Optional: Leave blank to use local Ollama only
GEMINI_API_KEY=

# Ollama configuration (local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ===================== WEBSOCKET =====================
# Port for orchestrator WebSocket server
WS_PORT=3001

# ===================== REPOSITORIES =====================
# Optional: Custom path for repo storage
# Default: ~/Documents/openhub/repos
OPENHUB_REPOS_ROOT=

# ===================== VIBESERVE (MCP SERVER) =====================
# Workspace root for VibeServe MCP tools
VIBESERVE_WORKSPACE=.

# ===================== OPTIONAL =====================
# Enable fast pipeline mode for E2E testing
# E2E_FAST_PIPELINE=1
